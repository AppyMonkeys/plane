{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests.
	# 300/min was too tight for this app in practice: a single cold page
	# load (uncached JS/CSS chunks, fonts, icons) alone fires 300+ requests
	# from one browser tab, tripping this for normal use rather than abuse.
	# Raised to a threshold a real user session won't hit while still
	# bounding a runaway client.
	rate_limit {
		zone static {
			key {client_ip}
			events 1200
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
