# Shared HTTPS front door for this host: terminates TLS (Let's Encrypt,
# auto-issued per domain below) and fans out by hostname -- each app gets
# its own subdomain and its own cert, so there's no path-prefix rewriting
# to worry about. Plane's own internal proxy still does its own routing
# to web/api/space/admin/live once traffic reaches it.
{$PLANE_DOMAIN} {
	reverse_proxy plane-app-proxy-1:80
}

{$DOCMOST_DOMAIN} {
	reverse_proxy docmost-docmost-1:3000
}
