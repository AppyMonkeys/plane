# Copy this file to .env and fill in the values marked below before
# running `docker compose up -d`. See README.md for the full setup guide.

# The hostname or IP this instance is reachable at (e.g. an EC2 public
# DNS name, or a LAN IP for local dev).
APP_DOMAIN=localhost
APP_RELEASE=v1.4.2

# Only needed if edge-proxy/ is fronting this host alongside docmost --
# docmost's own domain, so edge-proxy can route to it too. See
# edge-proxy/README.md. Leave unset if you're not running edge-proxy or
# don't have docmost alongside Plane.
DOCMOST_DOMAIN=

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# These are only used INTERNALLY by the `proxy` service now -- it no
# longer publishes a host port itself (see edge-proxy/README.md). Leave
# them at their defaults unless something else inside the docker network
# needs to reach `proxy` on a nonstandard port.
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# https if edge-proxy/ (shared Caddy, TLS) is fronting this stack;
# http://${APP_DOMAIN} (no port) if not -- see the top-level README.md.
WEB_URL=https://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}
API_BASE_URL=http://api:8000

#DB SETTINGS
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
# CHANGE ME -- do not use the default in production.
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# REDIS SETTINGS
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
# CHANGE ME -- do not use the default in production.
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# Unused when edge-proxy/ fronts this stack -- that's the thing getting
# the Let's Encrypt cert now, not this container's own internal Caddy.
# Only relevant if you're running `proxy` standalone (see README.md).
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Secret Key -- REQUIRED, generate a real value before deploying.
# python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"
# or: openssl rand -hex 32
SECRET_KEY=

# VAPID keys for browser push notifications (Web Push API). Generated once
# per instance; regenerating them invalidates every existing browser
# subscription (users would need to re-enable the toggle in Profile Settings
# -> Notifications). Generate with:
# python3 -c "
# import base64
# from cryptography.hazmat.primitives.asymmetric import ec
# from cryptography.hazmat.primitives import serialization
# def b64url(d): return base64.urlsafe_b64encode(d).rstrip(b'=').decode()
# k = ec.generate_private_key(ec.SECP256R1())
# pub = k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
# priv = k.private_numbers().private_value.to_bytes(32, 'big')
# print('VAPID_PUBLIC_KEY=' + b64url(pub)); print('VAPID_PRIVATE_KEY=' + b64url(priv))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push services (Google/Mozilla/etc.) may use this to contact you about a
# subscription issue -- set it to a real admin/support address you control.
VAPID_ADMIN_EMAIL=admin@example.com

# Exposes the OpenAPI/Swagger schema for the REST API at /api/schema/swagger-ui/
# (and /api/schema/redoc/) -- off by default, safe to leave on for a
# self-hosted instance; makes the API easier to explore/integrate against.
ENABLE_DRF_SPECTACULAR=1

# DATA STORE SETTINGS
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Gunicorn Workers
GUNICORN_WORKERS=1

# UNCOMMENT `DOCKER_PLATFORM` IF YOU ARE ON `ARM64` AND DOCKER IMAGE IS NOT AVAILABLE FOR RESPECTIVE `APP_RELEASE`
# DOCKER_PLATFORM=linux/amd64

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT=60/minute

# Per-IP throttle for anonymous authentication endpoints (magic-link
# generate / sign-in / sign-up, email sign-in). DRF format: "<n>/<period>"
# where period is second/minute/hour/day.
AUTHENTICATION_RATE_LIMIT=10/minute

# Live server environment variables -- REQUIRED, generate a real value.
# openssl rand -hex 32
LIVE_SERVER_SECRET_KEY=

# Webhook IP allowlist -- comma-separated IPs or CIDR ranges allowed as webhook targets
# even if they resolve to private networks (e.g. "10.0.0.0/8,192.168.1.0/24,172.16.0.5")
WEBHOOK_ALLOWED_IPS=

# Webhook hostname allowlist -- comma-separated hostnames that bypass the private-IP
# SSRF check. Useful for trusted internal services whose container/service IPs are
# dynamic (e.g. "silo,silo.namespace.svc.cluster.local")
WEBHOOK_ALLOWED_HOSTS=
DOCKERHUB_USER=makeplane
PULL_POLICY=if_not_present
CUSTOM_BUILD=false

# --- Backups (see backup-scripts/README.md) ---
# Backups run via a host cron job (backup-scripts/run-backup.sh), which
# stops the stack, streams a pg_dump + the uploads volume straight to S3
# (never to local disk), then restarts everything. REQUIRED -- the script
# has no local-storage fallback. Needs an IAM role (EC2) or `aws configure`
# credentials with s3:PutObject/DeleteObject/ListBucket on this bucket.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=plane
S3_BACKUP_KEEP=3
BACKUP_INTERVAL_SECONDS=18000
